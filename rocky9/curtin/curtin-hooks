# Install netplan for MAAS compatibility
dnf install -y netplan

# Create a basic netplan configuration
mkdir -p /etc/netplan
cat > /etc/netplan/01-netcfg.yaml << EOF
network:
  version: 2
  renderer: NetworkManager
EOF

# Make sure NetworkManager is enabled
systemctl enable NetworkManager

# Create a symlink to ensure netplan is in the PATH
if [ ! -e /usr/bin/netplan ]; then
    ln -s /usr/sbin/netplan /usr/bin/netplan
fi

# Make sure netplan is executable
chmod +x /usr/bin/netplan
